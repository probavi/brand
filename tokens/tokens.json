  "geometry": {
    "seal": {
      "viewbox": 240,
      "center": [
        120,
        120
      ],
      "radius": 98,
      "ring_stroke": 9,
      "ring_dasharray": [
        16,
        9
      ],
      "check_path": "M 72 122 L 109 166 L 172 81",
      "check_stroke": 16
    },
    "clearspace": "3 \u00d7 ring stroke width on all sides",
    "min_size_px": {
      "icon": 16,
      "lockup_height": 24
    }
  }
}
