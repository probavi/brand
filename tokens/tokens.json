{
  "$schema": "https://probavi.dev/schemas/brand-tokens-1.json",
  "version": 1,
  "color": {
    "ink": {
      "hex": "#1E2A4A",
      "rgb": [
        30,
        42,
        74
      ],
      "role": "Primary. Text, ring, dark surfaces."
    },
    "green": {
      "hex": "#0E9F6E",
      "rgb": [
        14,
        159,
        110
      ],
      "role": "The check, success, 'proven'. Accent only."
    },
    "mint": {
      "hex": "#4ADE9D",
      "rgb": [
        74,
        222,
        157
      ],
      "role": "The check on dark surfaces; success text in dark UI."
    },
    "paper": {
      "hex": "#F5F0E8",
      "rgb": [
        245,
        240,
        232
      ],
      "role": "Light background; light elements on Ink."
    },
    "border-sand": {
      "hex": "#D8D2C4",
      "rgb": [
        216,
        210,
        196
      ],
      "role": "Hairlines on Paper."
    }
  },
  "typography": {
    "family": {
      "sans": "Inter, system-ui, -apple-system, 'Segoe UI', sans-serif",
      "mono": "ui-monospace, SFMono-Regular, Menlo, Consolas, monospace"
    },
    "weight": {
      "regular": 400,
      "medium": 500
    },
    "note": "Wordmark: Inter Medium (500), lowercase. Never use weights above 500."
